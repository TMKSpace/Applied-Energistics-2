{
  "schemaVersion": 1,
  "id": "ae2",
  "version": "26.3.1-alpha.1",
  "name": "Applied Energistics 2 (Fabric)",
  "icon": "logo.png",
  "description": "Fabric port of Applied Energistics 2. A Minecraft mod about Matter, Energy and using them to conquer the world...",
  "environment": "*",
  "accessWidener": "ae2.accesswidener",
  "mixins": [
    "nfcompat.mixins.json",
    "nfcompat.ae2.mixins.json",
    "nfcompat.gametest.mixins.json"
  ],
  "entrypoints": {
    "main": [
      "nfcompat.integration.TrinketsHook::onInitialize"
    ],
    "server": [
      "nfcompat.NfCompatServer"
    ],
    "client": [
      "nfcompat.NfCompatClient"
    ],
    "jei_mod_plugin": [
      "appeng.client.integrations.jei.JEIPlugin"
    ],
    "jade": [
      "appeng.integration.modules.jade.JadeModule"
    ],
    "fabric-datagen": [
      "appeng.datagen.AE2DataGenerators"
    ],
    "modmenu": [
      "nfcompat.ModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=0.20.1",
    "fabric-api": "*",
    "minecraft": ">=26.3",
    "forgeconfigapiport": ">=26.3.1"
  },
  "recommends": {
    "team_reborn_energy": ">=5.0.0",
        "modmenu": "*",
    "trinkets_updated": "*"
  }
}
